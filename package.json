{
  "name": "zitong-qi-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env STATIC_EXPORT=1 next build",
    "build:sites": "npm run build:static && node scripts/prepare-sites-static.mjs",
    "build:open-next": "opennextjs-cloudflare build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint",
    "preview": "npm run build:sites && wrangler dev",
    "upload": "npm run build:sites && wrangler versions upload",
    "deploy": "npm run build:sites && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3",
    "wrangler": "4.114.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
